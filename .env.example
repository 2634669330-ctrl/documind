# ============================================================
# DocuMind 配置模板
# 复制为 .env 后按需修改：cp .env.example .env
# 所有字段都会覆盖 app/core/config.py 里的默认值（大小写不敏感）
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev
LOG_LEVEL=INFO
# 逗号分隔；生产建议写死前端域名，别用 *
CORS_ORIGINS=*

# ---------- 大模型 ----------
# 不填 LLM_API_KEY 会进入 mock 模式：链路能跑通，回答是本地模拟文本
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
# 强制 mock（即使配了 Key 也不调用真实模型）
MOCK_LLM=false
# 用 LangChain(LCEL) 编排代替自研流水线（需 pip install -r requirements-langchain.txt）
USE_LANGCHAIN=false

# ---------- 向量化 ----------
# hash  = 零依赖哈希向量，仅用于跑通链路（默认，装完依赖就能用）
# local = 本地 BGE-m3，效果最好，需要 pip install -r requirements-ml.txt
# api   = 调用 OpenAI 兼容的 /embeddings 接口（智谱、OpenAI、SiliconFlow 等）
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_API_MODEL=text-embedding-3-small

# ---------- 切分与检索 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
ENABLE_BM25=true
# 重排需要 requirements-ml.txt（CrossEncoder），CPU 上会慢一些
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
MIN_RELEVANCE=0.15

# ---------- 存储 ----------
DATA_DIR=data
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=documind_chunks
# persistent = 嵌入式（默认）；http = 连接 docker-compose 里的 chroma 服务
CHROMA_MODE=persistent
CHROMA_HOST=localhost
CHROMA_PORT=8001

# 本地开发用 SQLite，零配置
DATABASE_URL=sqlite:///data/documind.db
# Docker / 生产用 PostgreSQL
# DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind

MAX_UPLOAD_MB=50
